{
  "name": "board",
  "version": "0.1.0",
  "private": true,
  "description": "A GitHub-backed backlog triage board.",
  "type": "module",
  "engines": {
    "node": "24.13.0"
  },
  "packageManager": "npm@11.6.2",
  "scripts": {
    "build": "node scripts/build-board.mjs",
    "build:production": "node scripts/build-board.mjs --production",
    "dev": "vite",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "test": "vitest run",
    "test:artifact": "node scripts/verify-fixture-build.js",
    "test:artifact:production": "node scripts/verify-fixture-build.js --production",
    "install:server": "npm ci --prefix server",
    "lint:server": "eslint 'server/**/*.mjs'",
    "test:server": "npm --prefix server test",
    "audit:server": "npm --prefix server audit --omit=dev --audit-level=high",
    "test:composition": "node --test tests/composition/*.test.mjs",
    "test:browser": "playwright test",
    "test:browser:production": "playwright test --config playwright.production.config.js",
    "verify": "npm run format:check && npm run lint && npm test && npm run test:browser && npm run build && npm run test:artifact"
  },
  "dependencies": {
    "@alpinejs/csp": "3.17.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "eslint": "10.10.0",
    "globals": "17.12.0",
    "prettier": "3.9.6",
    "tailwindcss": "4.3.3",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  }
}
